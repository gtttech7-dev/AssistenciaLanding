---
import {site,absolute,whatsapp} from '../config/site';
import '../styles/global.css';
const {title,description,faqs=[],noindex=false}=Astro.props;
const canonical=absolute(Astro.url.pathname);
const business={"@context":"https://schema.org","@type":"LocalBusiness",name:site.name,description:site.seo.homeDescription,...(site.domain?{url:site.domain,image:absolute('/og.jpg')}:{}),...(site.phone?{telephone:site.phone}:{}),address:{"@type":"PostalAddress",addressLocality:site.city,addressRegion:site.state,addressCountry:'BR',...(site.address?{streetAddress:site.address}:{}),...(site.postalCode?{postalCode:site.postalCode}:{})},areaServed:{"@type":"City",name:site.city},...(site.mapsUrl?{hasMap:site.mapsUrl}:{}),sameAs:site.socials.map((s:any)=>s.url)};
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#07090d"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={site.indexable&&!noindex?'index,follow':'noindex,follow'}/>{canonical&&<link rel="canonical" href={canonical}/>}<meta property="og:type" content="website"/><meta property="og:locale" content="pt_BR"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>{canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:image" content={absolute('/og.jpg')||'/og.jpg'}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/favicon.svg"/>
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('gt-theme')||'dark'}catch{}</script>
<script type="application/ld+json" set:html={JSON.stringify(business).replace(/</g,'\u003c')}/>
{faqs.length>0&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map((f:any)=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}).replace(/</g,'\u003c')}/>}
</head><body><a class="skip" href="#main">Pular para o conteúdo</a><header><div class="container header-row"><a class="brand" href="/" aria-label={`${site.name}, página inicial`}><span class="brand-icon" aria-hidden="true">G<span>↗</span></span>{site.name}<span class="brand-dot">.</span></a><nav aria-label="Navegação principal" id="navigation"><a href="/#servicos">Serviços</a><a href="/#diferenciais">Por que a GT Tech?</a><a href="/#duvidas">Dúvidas</a><a href="/contato/">Contato</a></nav><div class="header-actions"><button id="theme-toggle" aria-label="Ativar tema claro" title="Alternar tema">◐</button><a class="header-contact" href={whatsapp()}>Fale com a gente <span aria-hidden="true">↗</span></a><button id="menu-toggle" aria-controls="navigation" aria-expanded="false" aria-label="Abrir menu">☰</button></div></div></header><main id="main"><slot/></main><footer class="container"><div class="footer-top"><div><a class="brand" href="/">{site.name}<span class="brand-dot">.</span></a><p>Tecnologia em boas mãos.<br/>Assistência técnica em {site.city} – {site.state}.</p></div><div><strong>Explore</strong><a href="/#servicos">Nossos serviços</a><a href="/#duvidas">Perguntas frequentes</a><a href="/contato/">Contato e localização</a><a href="/problemas-com-celular/">Dúvidas sobre defeitos</a></div><div><strong>Seu celular</strong>{site.services.map(s=><a href={`/${s.slug}/`}>{s.title}</a>)}</div><div><strong>Vamos conversar</strong><a href={whatsapp()}>Atendimento pelo WhatsApp ↗</a>{site.phone&&<a href={`tel:${site.phone.replace(/[^+\d]/g,'')}`}>{site.phone}</a>}{site.socials.map((s:any)=><a href={s.url} rel="noopener noreferrer" target="_blank">{s.name}</a>)}</div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} {site.name}. Todos os direitos reservados.</span><span>{site.city}, Goiás</span></div></footer><a class="floating-contact" href={whatsapp()} aria-label="Conversar com a GT Tech pelo WhatsApp"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.4 7.9L3 21l1.6-4.6A9 9 0 1 1 21 11.5Z"/><path d="M8 7c-2 3 3 8 6 9l2-2-3-2-1 1-2-2 1-1-2-3Z"/></svg></a>
<script>
const theme=document.querySelector<HTMLButtonElement>('#theme-toggle')!;
function sync(){theme.setAttribute('aria-label',document.documentElement.dataset.theme==='light'?'Ativar tema escuro':'Ativar tema claro');}
sync();theme.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='light'?'dark':'light';document.documentElement.dataset.theme=next;try{localStorage.setItem('gt-theme',next)}catch{}sync()});
const menu=document.querySelector<HTMLButtonElement>('#menu-toggle')!,nav=document.querySelector('#navigation')!;
function close(){menu.setAttribute('aria-expanded','false');nav.classList.remove('open')}
menu.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));nav.classList.toggle('open',open)});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});
</script></body></html>
