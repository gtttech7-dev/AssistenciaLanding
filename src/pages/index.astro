---
import Base from '../layouts/Base.astro';import CTA from '../components/CTA.astro';import Animation from '../components/Animation.astro';import FAQ from '../components/FAQ.astro';import Contact from '../components/Contact.astro';import {site,whatsapp} from '../config/site';
const extras=[{title:'Reparos de placa',description:'Análise técnica para falhas que exigem atenção aos componentes.',slug:'conserto-de-celular',number:'06'},{title:'Aparelho não liga',description:'Identificamos o que impede seu celular de voltar a funcionar.',slug:'conserto-de-celular',number:'07'}];
---
<Base title={site.seo.homeTitle} description={site.seo.homeDescription} faqs={site.faqs}>
<section class="hero container"><div class="hero-copy"><div class="local-tag"><span class="tiny-dot"></span> Assistência técnica em {site.city} – {site.state}</div><h1>{site.hero.title.split('\n').map((line,i)=><span class:list={{blue:i===1}}>{line}</span>)}</h1><p>{site.hero.description}</p><div class="hero-actions"><CTA label={site.hero.primary}/><a class="text-link" href="#servicos">Conhecer serviços <span aria-hidden="true">↓</span></a></div><div class="hero-note"><span aria-hidden="true">✓</span> Diagnóstico claro <span class="note-divider"></span> Atendimento de verdade</div></div><Animation/></section>
<div class="service-strip"><div class="container"><span>TELA</span><span>BATERIA</span><span>CONECTOR</span><span>PLACA</span><span>SOFTWARE</span><span>DIAGNÓSTICO</span></div></div>
<section class="container section" id="servicos"><div class="section-heading"><div><span class="eyebrow">O QUE A GENTE RESOLVE</span><h2>Um problema no celular.<br/>Uma solução com cuidado.</h2></div><p>Do reparo mais comum ao diagnóstico mais detalhado. Encontre o serviço que você precisa.</p></div><div class="services-grid">{[...site.services,...extras].map(s=><article class="service-card"><div class="card-top"><span class="service-symbol" aria-hidden="true">{s.number==='02'?'▰':s.number==='04'?'ϟ':s.number==='05'?'⌘':'▯'}</span><span class="card-number">{s.number}</span></div><h3><a href={`/${s.slug}/`}>{s.title}</a></h3><p>{s.description}</p><div class="card-links"><a href={whatsapp(s.title)}>Pedir orçamento ↗</a><a href={`/${s.slug}/`} aria-label={`Saiba mais sobre ${s.title}`}>Detalhes</a></div></article>)}<article class="service-card diagnostic"><span class="eyebrow">NÃO SABE O QUE É?</span><h3>Comece pelo<br/>diagnóstico.</h3><p>Conte o que aconteceu. A gente ajuda a entender o próximo passo.</p><a class="text-link" href={whatsapp('Diagnóstico técnico')}>Conversar com a equipe ↗</a></article></div></section>
<section class="difference" id="diferenciais"><div class="container section difference-grid"><div><span class="eyebrow">TECNOLOGIA EM BOAS MÃOS</span><h2>Seu celular faz parte<br/>da sua vida.<br/><span class="blue">A gente entende.</span></h2><p>Fotos, trabalho, conversas e rotina. Cada aparelho merece atenção, do primeiro contato à entrega.</p><CTA label="Converse com a GT Tech"/></div><div class="principles">{[['01','Clareza antes de tudo','Entenda o diagnóstico e confirme as condições do serviço antes de autorizar o reparo.'],['02','Atenção aos detalhes','Cada modelo e cada defeito pedem uma avaliação cuidadosa.'],['03','Contato direto, sem rodeios','Tire suas dúvidas e acompanhe as orientações de atendimento pelo WhatsApp.'],['04','Do diagnóstico ao pós-serviço','Converse com a equipe sobre os cuidados de uso após o reparo.']].map(([n,t,d])=><div><span>{n}</span><div><h3>{t}</h3><p>{d}</p></div></div>)}</div></div></section>
{site.stats.length>0&&<section class="container stats section" aria-label="Nossos números">{site.stats.map((s:any)=><div><strong>{s.value}</strong><span>{s.label}</span></div>)}</section>}
<section class="container section process"><span class="eyebrow">SIMPLES DO COMEÇO AO FIM</span><h2>De volta à sua rotina.<br/>Em três passos.</h2><div class="steps">{[['01','Conte o que aconteceu','Envie o modelo e descreva o problema pelo WhatsApp.'],['02','Entenda o diagnóstico','Confira as condições, o orçamento e o prazo do reparo.'],['03','Autorize o cuidado','Com tudo combinado, a equipe segue com o serviço.']].map(([n,t,d])=><div><span>{n}</span><h3>{t}</h3><p>{d}</p></div>)}</div></section>
{site.reviews.enabled&&<section class="reviews-section"><div class="container section"><div class="section-heading"><div><span class="eyebrow">EXPERIÊNCIAS DE ATENDIMENTO</span><h2>Confiança se constrói<br/>em cada conversa.</h2></div>{site.reviews.demo&&<p class="demo-label">Depoimentos ilustrativos para apresentação do layout. Não representam avaliações reais.</p>}</div><div class="reviews-grid">{site.reviews.items.map(r=><article class="review"><span class="stars" aria-label={`${r.rating} de 5 estrelas`}>{'★'.repeat(r.rating)}</span><blockquote>“{r.text}”</blockquote><div class="review-person"><span class="avatar">{r.name[0]}</span><div><strong>{r.name}</strong><small>{site.reviews.demo?'Exemplo fictício':r.date}</small></div></div></article>)}</div></div></section>}
<FAQ/><Contact/>
</Base>
